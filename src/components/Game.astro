---
<main class="app">
  <div class="ambient ambient-one" aria-hidden="true"></div>
  <div class="ambient ambient-two" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <section id="screen" class="screen"></section>
</main>
<script>
  import { FINALE_PUZZLE_TARGETS, advanceGift, beginFinalePuzzle, completeFinalePuzzle, completePuzzle, flipGift, initialState, markPuzzleSolved, restoreState, revealThirdImage, start, updateFinalePiece } from '../lib/game-state';
  import { isNearFinaleTarget } from '../lib/finale-puzzle';
  import { isChronological } from '../lib/timeline';
  import { mountDogRun } from '../lib/dog-run-ui';
  const KEY = 'anniversary-game-v2';
  const qualities = ['kedves','empatikus','megbocsátó','szerény','szorgalmas','alázatos','kitartó','rugalmas','nyitott','nagyvonalú','őszinte','figyelmes','türelmes','gondoskodó','melegszívű','humoros','okos','kreatív','céltudatos','lelkiismeretes','gyengéd','bátor','hűséges','kiegyensúlyozott','alkalmazkodó','megbízható','érzékeny','inspiráló','lelkes','szeretetteljes'];
  const personalQualities = new Set(['kedves','empatikus','megbocsátó','szerény','szorgalmas','alázatos','kitartó','rugalmas','nyitott','nagyvonalú']);
  const cards = ['Jutalmadat a nasitárban leled','A zene elfed','QR-kód a Netflixhez','Megtudod, ha készülődsz','Nézz a lábad elé','Mangó ebből nem kaphat'];
  const years = Array.from({length:10}, (_, i) => 2017 + i);
  const yearFiles: Record<number,{file:string,label:string}> = {2017:{file:'2017 esküvő.webp',label:'2017 esküvő'},2018:{file:'2018 fotózás.webp',label:'2018 fotózás'},2019:{file:'2019 Balatonfüred.webp',label:'2019 Balatonfüred'},2020:{file:'2020 Béke park.webp',label:'2020 Béke park'},2021:{file:'2021 Orfű.webp',label:'2021 Orfű'},2022:{file:'2022 Crikvenica.webp',label:'2022 Crikvenica'},2023:{file:'2023 Makó.webp',label:'2023 Makó'},2024:{file:'2024 Orfű.webp',label:'2024 Orfű'},2025:{file:'2025 Senj.webp',label:'2025 Senj'},2026:{file:'2026 Kaposvár.webp',label:'2026 Kaposvár'}};
  const asset = (file:string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/feladvany/${file}`;
  // This shortcut is deliberately compiled out of production builds.
  const devMode = import.meta.env.DEV && new URLSearchParams(location.search).has('dev');
  let state = loadState(); let feedback = ''; let timelineOrder = shuffle(years);
  if(devMode&&new URLSearchParams(location.search).has('dog-preview')&&!localStorage.getItem(KEY))state={...initialState(),screen:'puzzle',puzzleIndex:6};
  let dogGameCleanup = () => {};
  function loadState(){try{return restoreState(JSON.parse(localStorage.getItem(KEY) ?? 'null'));}catch{return initialState();}}
  function persist(){localStorage.setItem(KEY,JSON.stringify(state));}
  function change(next:typeof state){if(next.screen==='puzzle'&&next.puzzleIndex===2&&(state.screen!=='puzzle'||state.puzzleIndex!==2))timelineOrder=shuffle(years);state=next;persist();render();}
  function image(file:string,alt:string,className=''){return `<figure class="image-slot ${className}"><img src="${asset(file)}" alt="${alt}" /></figure>`;}
  function resetButton(){return `<nav class="topbar"><div class="brand-mark" aria-hidden="true"><span>10</span><i></i></div><button class="text-button" data-action="reset">Újrakezdés</button></nav>`;}
  function shuffle<T>(items:T[]){return [...items].sort(()=>Math.random()-.5);}
  function solve(message:string){change(completePuzzle(markPuzzleSolved(state),message));}
  function render(){dogGameCleanup();const el=document.querySelector<HTMLElement>('#screen');if(!el)return;if(state.screen==='intro')el.innerHTML=`<div class="hero"><div class="hero-seal" aria-hidden="true"><span>10</span><small>év</small></div><p class="hero-kicker">2016 · 2026</p><h1>Egy közös történet</h1><div class="flourish" aria-hidden="true"><i></i><span>◇</span><i></i></div><button data-action="start">Kezdjük el <span aria-hidden="true">→</span></button></div>`;if(state.screen==='puzzle')el.innerHTML=`${resetButton()}${puzzle(state.puzzleIndex!)}`;if(state.screen==='gift')el.innerHTML=`${resetButton()}${gift(state.puzzleIndex!)}`;if(state.screen==='finale')el.innerHTML=`${resetButton()}${finale()}`;if(state.screen==='completed')el.innerHTML=`${resetButton()}${completedFinale()}`;bind();if(state.screen==='puzzle'&&state.puzzleIndex===6)dogGameCleanup=mountDogRun(el,()=>{state={...state,dogRunWon:true};persist();},()=>solve('Ügyes vagy!'));}
  function puzzle(index:number){
    if(index===1)return `<article class="puzzle-panel"><p class="section-kicker">Egy emlék nyomában</p><h1 class="puzzle-title">Hol készült a fotó?</h1>${image('1.webp','Első feladvány fotója','portrait-memory')}<form id="answer" class="answer-form"><label class="sr-only" for="first-answer">Válasz</label><input id="first-answer" name="answer" autocomplete="off" placeholder="Írd be a válaszod"/><button>Ellenőrzés <span aria-hidden="true">→</span></button><p class="feedback">${feedback}</p></form></article>`;
    if(index===2)return `<article class="puzzle-panel timeline-panel"><p class="section-kicker">Közös idővonal</p><h1 class="puzzle-title">10 év tíz pillanat.</h1><p class="task-description">Emlékszel, milyen időrendben történtek?</p><div class="year-grid" id="years">${timelineOrder.map(year=>`<div class="year-card" draggable="true" data-year="${year}"><button class="info" type="button" draggable="false" data-info="${year}" aria-label="Információ">i</button><div class="info-popover"><span>${yearFiles[year].label}</span></div><img src="${asset(yearFiles[year].file)}" alt="Évfordulós emlék"/></div>`).join('')}</div><div class="action-row"><button data-action="check-years">Sorrend ellenőrzése <span aria-hidden="true">→</span></button><p class="feedback">${feedback}</p></div></article>`;
    if(index===3)return `<article class="puzzle-panel detail-panel"><p class="section-kicker">Egy kép mögött</p><h1 class="puzzle-title">Részletekben elveszve</h1><p class="task-description">Ez egy kivágott részlet. Kitalálod, mi van az eredeti képen?</p>${state.thirdImageRevealed?`<div class="reveal-comparison">${image('3b.webp','Közeli képrészlet','detail-crop')}${image('3.webp','Az eredeti teljes fotó','revealed-memory')}</div><button data-action="third-gift">Érdekel az ajándék <span aria-hidden="true">→</span></button>`:`${image('3b.webp','Közeli képrészlet','detail-crop')}<div class="choices">${['csoportkép hármunkról','fotó rólunk ősszel a bétel udvarán','csipkemúzeum emlékfotó'].map(answer=>`<button data-choice="${answer}">${answer}</button>`).join('')}</div><p class="feedback">${feedback}</p>`}</article>`;
    if(index===4)return `<article class="puzzle-panel qualities-panel"><p class="section-kicker">Ahogy én látlak</p><h1 class="puzzle-title">Megismerés</h1><p class="task-description">Mi jellemző rád? Én legalább 10-et tudok mondani, neked is ennyit kell találni.</p><div class="selection-status"><span>${state.selectedQualities.length}</span><small> / 10 kiválasztva</small></div><div class="tags">${qualities.map(q=>`<button class="tag ${state.selectedQualities.includes(q)?'selected':''}" data-quality="${q}">${q}</button>`).join('')}</div><button data-action="lock-qualities" ${state.selectedQualities.length===10?'':'disabled'}>Lezárom <span aria-hidden="true">→</span></button><p class="feedback">${feedback}</p></article>`;
    if(index===5)return `<article class="puzzle-panel compare-panel"><p class="section-kicker">Két pillanat</p><h1 class="puzzle-title">Fakuló emlékek?</h1><p class="task-description">Keresd meg a különbségeket</p><div class="compare">${image('5a.webp','Első összehasonlítandó kép')}${image('5b.webp','Második összehasonlítandó kép')}</div><button data-action="manual">Megtaláltam! <span aria-hidden="true">→</span></button></article>`;
    return `<article class="puzzle-panel game-panel"><p class="section-kicker">Egy kis közös kaland</p><h1 class="puzzle-title">Mangó nyomában</h1><p class="task-description">Érd utol Mangót a ház előtt! Futás közben a SPACE billentyűvel ugord át, amit maga mögött hagy.</p><canvas class="dog-run-canvas" width="1000" height="440" tabindex="0" role="img" aria-label="Oldalnézetes futójáték: barna, göndör hajú nő követi Mangót, a francia bulldogot"></canvas><div class="dog-run-actions"><button class="dog-run-button" type="button">Indulás!</button><p class="dog-run-status" aria-live="polite">A futam csak az Indulás! gombbal kezdődik.</p></div></article>`;
  }
  function giftIcon(){return `<svg class="gift-icon" viewBox="0 0 64 64" aria-hidden="true"><path d="M12 27h40v27H12zM8 19h48v10H8zM31 19v35M18 19c-7-7 1-15 7-8l7 8M46 19c7-7-1-15-7-8l-7 8"/></svg>`;}
  function gift(index:number){const netflix=index===3;const front=netflix?`<img class="qr" src="${asset('netflix-qr.svg')}" alt="A Netflix főoldalára vezető QR-kód"/>`:`<div class="gift-content">${giftIcon()}<strong class="gift-location">${cards[index-1]}</strong></div>`;const comparison=index===4?`<section class="qualities-summary"><p>Én ezeket értékelem benned:</p><div class="tags">${[...personalQualities].map(q=>`<span class="tag personal-choice">${q}</span>`).join('')}</div></section>`:'';return `<article class="card-stage ${netflix?'netflix-card':''}">${netflix?'<p class="gift-title">Ajándék!</p>':''}${comparison}<p class="feedback gift-message">${state.giftMessage}</p><div class="gift" data-action="flip" role="button" tabindex="0" aria-label="Ajándékkártya megfordítása"><div class="gift-inner ${state.giftFlipped?'is-flipped':''}"><div class="face back"><span class="ten">10</span><small>éve együtt</small><i aria-hidden="true"></i></div><div class="face front">${front}</div></div></div>${state.giftFlipped?'<button class="continue-button" data-action="next">Megvan! <span aria-hidden="true">→</span></button>':''}</article>`;}
  function finalePoem(){return '<p class="poem">Tíz szép évért hálás vagyok,<br/>Érted ma is hálát adok.<br/>Köszönöm a sok szép évet,<br/>S veled mindazt, ami éltet.</p>';}
  function finaleCardArt(){return `<div class="finale-card-art">${giftIcon()}<strong>Szeretsz ölelni?</strong><i aria-hidden="true"></i></div>`;}
  function finalePuzzle(){return `<div class="finale-puzzle-wrap"><p class="puzzle-hint">Rakd össze a kártyát.</p><div class="finale-puzzle-stage" aria-label="Kilencdarabos kirakó"> <div class="puzzle-board-guide" aria-hidden="true"></div>${state.finalePieces.map(piece=>{const target=FINALE_PUZZLE_TARGETS[piece.id];const col=piece.id%3;const row=Math.floor(piece.id/3);return `<div class="finale-piece ${piece.locked?'locked':'loose'}" data-finale-piece="${piece.id}" aria-label="${piece.id+1}. kirakódarab${piece.locked?', a helyén':''}" style="--x:${piece.x}%;--y:${piece.y}%;--target-x:${target.x}%;--target-y:${target.y}%;--crop-x:${-col*100}%;--crop-y:${-row*100}%;--delay:${piece.id*45}ms">${finaleCardArt()}</div>`;}).join('')}</div></div>`;}
  function finale(){if(state.finalePhase==='card')return `<article class="final finale-card-screen"><div class="finale-star" aria-hidden="true">✦</div>${finalePoem()}<div class="gift finale-gift" data-action="final-card" role="button" tabindex="0" aria-label="A finálé kirakójának megnyitása"><div class="gift-inner"><div class="face back"><span class="ten">10</span><small>éve együtt</small><i aria-hidden="true"></i></div></div></div></article>`;return `<article class="final finale-puzzle-screen"><div class="finale-star" aria-hidden="true">✦</div>${finalePoem()}${finalePuzzle()}</article>`;}
  function completedFinale(){return `<article class="final completed"><div class="finale-star" aria-hidden="true">✦</div>${finalePoem()}<div class="completed-puzzle-card" aria-live="polite">${finaleCardArt()}</div></article>`;}
  function flipVisibleGift(card:HTMLElement){if(state.screen!=='gift'||state.giftFlipped)return;state=flipGift(state);persist();const inner=card.querySelector<HTMLElement>('.gift-inner');if(!inner){render();return;}inner.addEventListener('transitionend',event=>{if(event.propertyName==='transform')render();},{once:true});requestAnimationFrame(()=>inner.classList.add('is-flipped'));}
  function bind(){document.querySelectorAll<HTMLElement>('[data-action]').forEach(button=>button.onclick=()=>{const action=button.dataset.action;if(action==='start')change(start(state));if(action==='flip')flipVisibleGift(button);if(action==='next'){feedback='';change(advanceGift(state));}if(action==='third-gift')change(completePuzzle(state));if(action==='final-card')change(beginFinalePuzzle(state));if(action==='check-years')checkYears();if(action==='lock-qualities')lockQualities();if(action==='manual')solve('Ezért is jár ajándék');if(action==='reset'&&confirm('Biztosan újrakezded a játékot?')){state=initialState();feedback='';persist();render();}});document.querySelector<HTMLFormElement>('#answer')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const answer=new FormData(form).get('answer')?.toString()??'';const accepted=['fürdőkád','fürdőkádban','fürdőben','fürdő','kozármisleny','kozármislenyben','lakásomban'];if(accepted.map(normalize).includes(normalize(answer)))solve('Bizony, jól emlékszel!');else{feedback='Biztos?';render();}});document.querySelectorAll<HTMLElement>('[data-choice]').forEach(button=>button.onclick=()=>{if(button.dataset.choice==='csoportkép hármunkról')change(markPuzzleSolved(revealThirdImage(state)));else{feedback='Biztos?';render();}});document.querySelectorAll<HTMLButtonElement>('[data-quality]').forEach(button=>button.onclick=()=>{const quality=button.dataset.quality!;const selected=state.selectedQualities.includes(quality);if(!selected&&state.selectedQualities.length===10)return;state={...state,selectedQualities:selected?state.selectedQualities.filter(item=>item!==quality):[...state.selectedQualities,quality]};persist();render();});document.querySelectorAll<HTMLElement>('[data-info]').forEach(button=>{button.onclick=(event)=>{event.preventDefault();event.stopPropagation();button.closest('.year-card')?.classList.toggle('show-info');};button.onpointerdown=event=>event.stopPropagation();button.ondragstart=event=>event.preventDefault();});document.querySelectorAll<HTMLElement>('.gift').forEach(card=>{const inner=card.querySelector<HTMLElement>('.gift-inner');card.onpointermove=event=>{if(!inner||inner.classList.contains('is-flipped'))return;const box=card.getBoundingClientRect();inner.style.setProperty('--rx',`${((event.clientY-box.top)/box.height-.5)*-5}deg`);inner.style.setProperty('--ry',`${((event.clientX-box.left)/box.width-.5)*7}deg`);};card.onpointerleave=()=>{inner?.style.setProperty('--rx','0deg');inner?.style.setProperty('--ry','0deg');};card.onkeydown=event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();card.click();}};});dragSetup();finalePuzzleDragSetup();}
  function normalize(value:string){return value.toLocaleLowerCase('hu-HU').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().replace(/\s+/g,' ');}
  function checkYears(){if(isChronological(timelineOrder))solve('Én ezt nem tudtam volna.');else{feedback='Még nem ez a sorrend.';render();}}
  function lockQualities(){if(state.selectedQualities.length!==10){return;}const locked={...state,qualitiesLocked:true};change(completePuzzle(markPuzzleSolved(locked),'Jöhet egy ajándék?'));}
  function dragSetup(){let dragged:HTMLElement|undefined;document.querySelectorAll<HTMLElement>('.year-card').forEach(card=>{card.ondragstart=()=>{dragged=card;};card.ondragover=event=>event.preventDefault();card.ondrop=()=>{if(dragged&&dragged!==card){card.parentElement?.insertBefore(dragged,card);timelineOrder=[...document.querySelectorAll<HTMLElement>('.year-card')].map(item=>Number(item.dataset.year));}};});}
  function finalePuzzleDragSetup(){const stage=document.querySelector<HTMLElement>('.finale-puzzle-stage');if(!stage)return;document.querySelectorAll<HTMLElement>('[data-finale-piece]').forEach(piece=>{if(piece.classList.contains('locked'))return;piece.onpointerdown=event=>{event.preventDefault();const id=Number(piece.dataset.finalePiece);const stageBox=stage.getBoundingClientRect();const pieceBox=piece.getBoundingClientRect();const offsetX=event.clientX-pieceBox.left;const offsetY=event.clientY-pieceBox.top;let x=pieceBox.left-stageBox.left;let y=pieceBox.top-stageBox.top;piece.setPointerCapture(event.pointerId);piece.classList.add('dragging');piece.style.animation='none';piece.onpointermove=moveEvent=>{x=Math.max(0,Math.min(stageBox.width-pieceBox.width,moveEvent.clientX-stageBox.left-offsetX));y=Math.max(0,Math.min(stageBox.height-pieceBox.height,moveEvent.clientY-stageBox.top-offsetY));piece.style.left=`${x}px`;piece.style.top=`${y}px`;};const release=(releaseEvent:PointerEvent)=>{piece.onpointermove=null;piece.onpointerup=null;piece.onpointercancel=null;if(piece.hasPointerCapture(releaseEvent.pointerId))piece.releasePointerCapture(releaseEvent.pointerId);piece.classList.remove('dragging');const target=FINALE_PUZZLE_TARGETS[id];const targetX=stageBox.width*target.x/100;const targetY=stageBox.height*target.y/100;const locked=isNearFinaleTarget(x,y,targetX,targetY,pieceBox.width);const nextX=locked?target.x:x/stageBox.width*100;const nextY=locked?target.y:y/stageBox.height*100;state=updateFinalePiece(state,id,nextX,nextY,locked);persist();piece.style.left=`${nextX}%`;piece.style.top=`${nextY}%`;if(locked){piece.classList.remove('loose');piece.classList.add('locked');piece.style.removeProperty('animation');piece.setAttribute('aria-label',`${id+1}. kirakódarab, a helyén`);}if(state.finalePieces.every(item=>item.locked)){state=completeFinalePuzzle(state);persist();const finish=()=>render();if(matchMedia('(prefers-reduced-motion: reduce)').matches){requestAnimationFrame(finish);}else{const onGlowEnd=(event:AnimationEvent)=>{if(event.animationName!=='finale-glow')return;stage.removeEventListener('animationend',onGlowEnd);finish();};stage.addEventListener('animationend',onGlowEnd);stage.classList.add('is-completing');}}};piece.onpointerup=release;piece.onpointercancel=release;};});}
  document.addEventListener('pointerdown', (event) => {
    const target = event.target as Element;
    if (!target.closest('.info, .info-popover')) document.querySelectorAll('.year-card.show-info').forEach((card) => card.classList.remove('show-info'));
  });
  render();
</script>
<style is:global>
  *{box-sizing:border-box}body{margin:0;background:#f7f0e8;color:#342d2a;font-family:Georgia,serif}button,input{font:inherit}.app{max-width:1280px;margin:auto;padding:24px}.screen{min-height:90vh}.hero,.card-stage,.final,article{background:#fffaf5;border:1px solid #d8c5b7;border-radius:20px;padding:clamp(24px,3vw,40px);box-shadow:0 18px 60px #4d2b1712}.hero{text-align:center;margin-top:8vh}.hero h1{font-size:clamp(2.8rem,7vw,5rem);font-weight:400}.final h1{font-size:clamp(2rem,6vw,4.5rem);font-weight:400}.puzzle-title{font-size:clamp(2rem,4vw,3.25rem);font-weight:400;margin:0 0 .35rem}.task-description{margin:0 0 1.25rem;font-size:1rem}.hero button,article>button,form button{background:#7e4d42;color:#fff;border:0;border-radius:999px;padding:12px 22px;cursor:pointer}.hero button:disabled,article>button:disabled{cursor:not-allowed;opacity:.45}.text-button{border:0;background:none;color:#7e4d42;cursor:pointer}nav{display:flex;justify-content:flex-end;margin-bottom:10px}.progress{height:6px;background:#e6d8cc;margin-bottom:20px}.progress i{display:block;height:100%;background:#b67962}.image-slot{min-height:170px;background:#eadfd6;border-radius:12px;display:grid;place-items:center;overflow:hidden;margin:20px 0}.image-slot img{width:100%;max-height:420px;object-fit:contain}.year-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin:18px 0;user-select:none}.year-card{position:relative;min-width:0;aspect-ratio:1/1;background:#eadfd6;border-radius:10px;overflow:hidden;display:grid;place-items:center;cursor:grab;user-select:none}.year-card:active{cursor:grabbing}.year-card img{display:block;width:100%;height:100%;padding:4px;object-fit:contain;pointer-events:none}.info{position:absolute;right:6px;top:5px;z-index:2;border:0;border-radius:50%;width:22px;height:22px;padding:0;background:#fffc;color:#342d2a;cursor:pointer}.info-popover{display:none;position:absolute;z-index:3;inset:31px 5px auto 5px;padding:7px;background:#fffaf5;border:1px solid #7e4d42;border-radius:7px;font-size:.72rem;line-height:1.2;box-shadow:0 4px 12px #0003}.year-card.show-info .info-popover{display:block}.info-popover span{display:block;padding-right:14px}.choices,.tags{display:flex;flex-wrap:wrap;gap:10px}.choices button,.tag{border:1px solid #c9a99a;background:#fff;border-radius:999px;padding:10px 14px;cursor:pointer}.tag.selected{background:#6d947e;color:#fff;border-color:#6d947e}.tag.personal-choice{outline:3px solid #c58c52;outline-offset:2px}.qualities-summary{margin-bottom:22px}.feedback{min-height:1.5em;color:#7e4d42}.compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.compare .image-slot{height:clamp(270px,30vw,390px);margin:0}.compare .image-slot img{width:100%;height:100%;object-fit:contain}.game-placeholder{padding:50px;text-align:center;border:2px dashed #b67962;border-radius:12px}.gift{width:min(360px,90vw);height:230px;margin:24px auto;position:relative;transform-style:preserve-3d;transition:transform .6s;cursor:pointer}.gift.flipped{transform:rotateY(180deg)}.face{position:absolute;inset:0;backface-visibility:hidden;border-radius:16px;display:grid;place-items:center;padding:25px;text-align:center}.back{background:#9b6758;color:#f7e8d8;font-size:5rem;border:8px double #e6c3a7}.front{transform:rotateY(180deg);background:#fff4e7;border:1px solid #b67962;font-size:1.4rem}.gift-content{display:flex;max-width:100%;flex-direction:column;align-items:center;gap:14px}.gift-location{display:block;max-width:100%;font-size:1.35rem;line-height:1.25}.gift-icon{font-size:3rem}.qr{font-size:7rem}.puzzle{display:grid;grid-template-columns:repeat(3,1fr);width:220px;height:220px;margin:28px auto}.puzzle span{display:grid;place-items:center;border:1px solid #fff;background:#b67962;color:#fff}.muted{color:#886f65}.final{text-align:center;margin-top:8vh}.poem{font-size:1.25rem;line-height:1.6}@media(max-width:760px){.year-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.compare{grid-template-columns:1fr}.compare .image-slot{height:300px}} 
  .gift-title{margin:0;text-align:center;font-size:1.05rem;color:#7e4d42}
</style>
<style is:global>
  /* Compact desktop layout and photo-led presentation. */
  .app {
    width: min(100%, 1260px);
    padding: 10px 18px 14px;
  }
  .screen { min-height: calc(100vh - 24px); }
  .topbar { min-height: 32px; margin-bottom: 6px; }
  .progress { display: none; }

  article { padding: clamp(22px, 2.4vw, 36px); }
